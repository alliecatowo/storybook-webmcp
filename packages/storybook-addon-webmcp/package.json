{
  "name": "storybook-addon-webmcp",
  "version": "0.1.0",
  "description": "Compiles the live semantic state of your Storybook into a WebMCP capability surface, so a browser agent works inside the exact Storybook session you are using.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alliecatowo/storybook-webmcp.git",
    "directory": "packages/storybook-addon-webmcp"
  },
  "bugs": {
    "url": "https://github.com/alliecatowo/storybook-webmcp/issues"
  },
  "homepage": "https://github.com/alliecatowo/storybook-webmcp#readme",
  "type": "module",
  "keywords": [
    "storybook-addons",
    "webmcp",
    "mcp",
    "agent",
    "model-context"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "storybook": {
    "displayName": "WebMCP",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "svelte",
      "web-components",
      "html"
    ]
  },
  "author": "Allison Coleman <me@allisons.dev>"
}
