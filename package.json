{
  "name": "storybook-webmcp-workspace",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "Development workspace for Storybook WebMCP and its vendored demonstration host.",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build --config examples/mealdrop/vite.config.ts",
    "build-all": "npm run build && npm run build-storybook",
    "build-storybook": "npm run build:addon && storybook build --config-dir examples/mealdrop/.storybook --output-dir build/storybook",
    "build-storybook:test": "storybook build --config-dir examples/mealdrop/.storybook --output-dir build/storybook --test",
    "lint": "oxlint --fix . && oxfmt .",
    "lint:check": "oxlint . && oxfmt --check .",
    "serve": "vite preview",
    "serve:storybook": "vite preview --outDir build/storybook --port 6006",
    "start": "vite --config examples/mealdrop/vite.config.ts",
    "check": "tsc --noEmit && npm run check --workspace packages/storybook-addon-webmcp",
    "storybook": "npm run build:addon && storybook dev --config-dir examples/mealdrop/.storybook -p 6006",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt .",
    "build:addon": "npm run build --workspace packages/storybook-addon-webmcp"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@use-it/event-listener@npm:^0.1.2": "patch:@use-it/event-listener@npm%3A0.1.7#~/.yarn/patches/@use-it-event-listener-npm-0.1.7-56ef42a654.patch"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-loading-skeleton": "^3.5.0",
    "react-lottie-player": "^2.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.4.4",
    "stylis": "^4.4.0",
    "typescript": "^7.0.2",
    "use-dark-mode": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@types/react-transition-group": "^4.4.12",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-storybook": "^10.5.5",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.0",
    "storybook": "^10.5.5",
    "storybook-addon-test-codegen": "^3.0.4",
    "storybook-addon-webmcp": "workspace:*",
    "tsup": "^8.5.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0",
  "msw": {
    "workerDirectory": "examples/mealdrop/public"
  },
  "workspaces": [
    "packages/*"
  ]
}
